# Copiez ce fichier en .env (jamais versionné). Sur Netlify, saisissez les mêmes variables dans
# Site configuration > Environment variables.

# ---- Réglages publics (préfixe VITE_ : visibles dans le navigateur, jamais de secret ici) ----
# URL publique du site, sans barre finale
VITE_SITE_URL=https://www.camayenneplage.com
# Formulaire de devis : clé d’accès Web3Forms (https://web3forms.com, gratuit, créée avec camayenneplagejpc224@gmail.com).
# Vide : le bouton ouvre la messagerie du visiteur avec l’e-mail déjà rédigé.
VITE_WEB3FORMS_KEY=
# Statistiques Plausible (https://plausible.io) : le domaine du site, ex. camayenneplage.com. Vide : désactivé.
VITE_PLAUSIBLE_DOMAIN=
# Vidéo Facebook du lecteur intégré (adresse complète de la vidéo si le lien de partage ne s’affiche pas)
VITE_FACEBOOK_VIDEO=https://www.facebook.com/share/v/1D1iJD4rRG/
# Pages officielles (icônes du pied de page, affichées seulement si renseignées)
VITE_FACEBOOK_PAGE=
VITE_INSTAGRAM_PAGE=
VITE_TIKTOK_PAGE=
# Numéro Orange Money qui reçoit les acomptes tant que CinetPay n’est pas configuré (transfert puis confirmation WhatsApp)
VITE_ORANGE_MONEY_NUMBER=+224 620 613 554

# Mode démonstration du paiement : 1 pour afficher le formulaire complet sans clé (paiement simulé, aucun débit).
# À laisser vide en production.
VITE_PAYMENT_DEMO=

# ---- Fonctions de paiement (côté serveur, secrets) ----
# URL publique (retours et notifications de paiement). Sur Netlify, l’URL du site est utilisée si vide.
SITE_URL=https://www.camayenneplage.com
# Paiement en ligne via CinetPay (API v1) : clé API (sk_live_… en production, sk_test_… pour le bac à sable) et mot de passe API,
# tous deux dans le tableau de bord marchand (panel.cinetpay.net). Vides : Orange Money en mode manuel (transfert + WhatsApp).
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Carte bancaire : mettre 1 seulement si CinetPay a activé la carte sur votre compte (sinon l’option reste « Bientôt disponible »)
CINETPAY_CARD=
# Facultatif : forcer l’adresse de l’API (déduite de la clé par défaut : https://api.cinetpay.co ou https://api.cinetpay.net)
CINETPAY_API_URL=
# Administration /admin : base PostgreSQL (fournie par l’intégration Neon de Vercel ; « pglite » en local pour tester),
# mot de passe de l’équipe et clé de signature des sessions (longue chaîne aléatoire). Vides : /admin affiche « non configurée ».
DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SECRET=
# Facultatif : clé Web3Forms pour recevoir un e-mail « Acompte reçu » à chaque paiement confirmé
WEB3FORMS_KEY=
